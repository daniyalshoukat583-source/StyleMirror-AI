{
  "manifest_version": 3,
  "name": "StyleMirror AI",
  "version": "1.0.0",
  "description": "AI-powered Virtual Try-On and Personal Fashion Stylist",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "StyleMirror AI",
    "default_popup": "popup.html"
}

}